# Copy to .env and edit. Never commit .env. Put no keys here: use `aws configure` or an AWS profile.
DATABASE_URL=postgresql+psycopg2://gauge:gauge@localhost:5432/gauge
AWS_REGION=us-east-1
# AWS_PROFILE=default
# Optional: save every raw output to S3 (costs a little). Leave false to stay free.
SAVE_RAW_TO_S3=false
# S3_BUCKET=
MAX_CONCURRENCY=4
MAX_OUTPUT_TOKENS=400
MAX_TOOL_STEPS=8
REQUEST_TIMEOUT_S=60
BUDGET_CAP_USD=3.0
JUDGE_MODEL=nova-lite
# Optional: a local model server with an OpenAI style API (Ollama's default is below). No key needed.
# LOCAL_BASE_URL=http://localhost:11434/v1
# Optional: SageMaker endpoint run (see docs/sagemaker.md). The role ARN is not a secret, but keep it out of the repo.
# SAGEMAKER_ROLE_ARN=
# SAGEMAKER_INSTANCE_TYPE=ml.g5.2xlarge
# Hourly price of that instance from the SageMaker pricing page. Costs are reported from it.
# SAGEMAKER_HOURLY_USD=
